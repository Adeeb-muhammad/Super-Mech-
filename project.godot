; Engine configuration file.
; Godot 4.6 / .NET 8 project configuration.

config_version=5

[application]

config/name="Super Mech"
run/main_scene="res://Scenes/Workshop/workshop.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="super mech"

[autoload]

MechStatManager="*res://Scripts/Mech/MechStatManager.cs"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
