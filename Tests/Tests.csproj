<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Link pure workshop-domain sources; the test project does not need
       Godot's SDK, editor source generators, or a running engine. -->
  <ItemGroup>
    <Compile Include="../Scripts/Mech/MechBuildRules.cs" Link="MechBuildRules.cs" />
    <Compile Include="../Scripts/Mech/Workshop/WorkshopPartDefinition.cs" Link="WorkshopPartDefinition.cs" />
    <Compile Include="../Scripts/Mech/Workshop/WorkshopCatalog.cs" Link="WorkshopCatalog.cs" />
    <Compile Include="../Scripts/Mech/Workshop/WorkshopLoadoutData.cs" Link="WorkshopLoadoutData.cs" />
    <Compile Include="../Scripts/Mech/Workshop/WorkshopLoadoutCodec.cs" Link="WorkshopLoadoutCodec.cs" />
  </ItemGroup>
</Project>
